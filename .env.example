# Core runtime
MARKET_SCORE_TIMEZONE=Europe/Rome
MARKET_SCORE_LOG_LEVEL=INFO
MARKET_SCORE_DRY_RUN=true
MARKET_SCORE_MAX_TICKERS_PER_RUN=100

# Market data and metrics
MARKET_SCORE_BENCHMARK_SYMBOL=SPY
MARKET_SCORE_DEFAULT_HISTORY_PERIOD=3y
MARKET_SCORE_HISTORY_INTERVAL=1d
MARKET_SCORE_RISK_FREE_RATE_ANNUAL=0.02

# News context
MARKET_SCORE_MAX_COMPANY_NEWS=5
MARKET_SCORE_MAX_SECTOR_NEWS=5
MARKET_SCORE_NEWS_WINDOW_DAYS=30
MARKET_SCORE_NEWS_SUMMARY_CHAR_LIMIT=420
MARKET_SCORE_ALLOW_MOCK_NEWS=true

# ── LLM backend (pick one) ─────────────────────────────────────────────────────
# Set DRY_RUN=false and configure a backend to enable live LLM analysis.
# The platform supports any OpenAI-compatible API endpoint.
#
# Option A — Ollama (local, 100% free, no internet required)
#   Install: https://ollama.com  →  ollama pull llama3.2
#   MARKET_SCORE_LLM_BASE_URL=http://localhost:11434/v1
#   MARKET_SCORE_LLM_MODEL=llama3.2
#   MARKET_SCORE_LLM_USE_JSON_SCHEMA=false   # Ollama uses json_object mode
#
# Option B — Groq (free tier, 14 400 req/day, very fast)
#   Sign up at https://console.groq.com → create API key
#   MARKET_SCORE_LLM_BASE_URL=https://api.groq.com/openai/v1
#   MARKET_SCORE_LLM_API_KEY=gsk_...
#   MARKET_SCORE_LLM_MODEL=llama-3.1-8b-instant
#
# Option C — Google Gemini (free tier)
#   Sign up at https://aistudio.google.com → create API key
#   MARKET_SCORE_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   MARKET_SCORE_LLM_API_KEY=AIza...
#   MARKET_SCORE_LLM_MODEL=gemini-2.0-flash
#
# Option D — OpenAI (paid, original backend)
#   MARKET_SCORE_OPENAI_API_KEY=sk-...

# Active LLM settings (uncomment one option above and set these):
# MARKET_SCORE_LLM_BASE_URL=http://localhost:11434/v1
# MARKET_SCORE_LLM_API_KEY=
# MARKET_SCORE_LLM_MODEL=llama3.2
# MARKET_SCORE_LLM_USE_JSON_SCHEMA=false

# ── Legacy OpenAI settings (backward compatibility) ───────────────────────────
MARKET_SCORE_OPENAI_MODEL_TICKER=gpt-4o-mini
MARKET_SCORE_OPENAI_MODEL_WEEKLY=gpt-4o-mini
MARKET_SCORE_OPENAI_MODEL_NEWS=gpt-4o-mini
MARKET_SCORE_OPENAI_USE_BATCH=false
MARKET_SCORE_OPENAI_COMPLETION_WINDOW=24h
MARKET_SCORE_OPENAI_POLL_INTERVAL_SECONDS=30
MARKET_SCORE_OPENAI_MAX_WAIT_MINUTES=180

# Token budgets
MARKET_SCORE_OPENAI_TICKER_MAX_COMPLETION_TOKENS=1500
MARKET_SCORE_OPENAI_WEEKLY_MAX_COMPLETION_TOKENS=2000
MARKET_SCORE_OPENAI_NEWS_MAX_OUTPUT_TOKENS=8000
MARKET_SCORE_OPENAI_NEWS_SEARCH_CONTEXT_SIZE=high
MARKET_SCORE_OPENAI_NEWS_WORKERS=1

# Webapp backend URL
VITE_API_BASE_URL=http://localhost:8000
